<%- include('_head.ejs') %>

<div class="card text-white bg-secondary">
  <div class="card-header bg-info h3">
    <i class="fas fa-home"></i> &nbsp; CASA
  </div>
  <div class="card-body text-center">
    <div class="row justify-content-center">
      <div class="col-md-8">
        <img src="https://upload.wikimedia.org/wikipedia/commons/thumb/4/44/Microsoft_logo.svg/512px-Microsoft_logo.svg.png" 
             alt="Microsoft Logo" 
             class="img-fluid mb-4" 
             style="max-width: 300px;">
        
        <h2 class="text-primary mb-4">Microsoft Corporation</h2>
        
        <div class="text-start">
          <h4 class="text-success mb-3">Sobre a Empresa</h4>
          <p class="lead">
            A Microsoft Corporation é uma empresa multinacional americana de tecnologia com sede em Redmond, Washington. 
            Fundada em 1975 por Bill Gates e Paul Allen, a Microsoft tornou-se uma das maiores empresas de software do mundo.
          </p>
          
          <h5 class="text-info">Principais Produtos e Serviços:</h5>
          <ul class="list-unstyled">
            <li><i class="fas fa-check text-success"></i> <strong>Microsoft Windows</strong> - Sistema operacional líder mundial</li>
            <li><i class="fas fa-check text-success"></i> <strong>Microsoft Office</strong> - Suite de produtividade mais utilizada</li>
            <li><i class="fas fa-check text-success"></i> <strong>Microsoft Azure</strong> - Plataforma de computação em nuvem</li>
            <li><i class="fas fa-check text-success"></i> <strong>Microsoft Teams</strong> - Solução de colaboração e comunicação</li>
            <li><i class="fas fa-check text-success"></i> <strong>Xbox</strong> - Console de jogos e serviços de gaming</li>
            <li><i class="fas fa-check text-success"></i> <strong>LinkedIn</strong> - Rede social profissional</li>
          </ul>
          
          <h5 class="text-info">Missão da Empresa:</h5>
          <blockquote class="blockquote">
            <p class="mb-0">"Capacitar cada pessoa e cada organização no planeta a alcançar mais."</p>
          </blockquote>
          
          <div class="mt-4">
            <h5 class="text-info">Dados da Empresa:</h5>
            <div class="row">
              <div class="col-md-6">
                <p><strong>Fundação:</strong> 4 de abril de 1975</p>
                <p><strong>Fundadores:</strong> Bill Gates e Paul Allen</p>
                <p><strong>CEO:</strong> Satya Nadella</p>
              </div>
              <div class="col-md-6">
                <p><strong>Sede:</strong> Redmond, Washington, EUA</p>
                <p><strong>Funcionários:</strong> Mais de 220.000 (2023)</p>
                <p><strong>Receita:</strong> Mais de $200 bilhões anuais</p>
              </div>
            </div>
          </div>
        </div>
      </div>
    </div>
  </div>
</div>

<%- include('_foot.ejs') %>